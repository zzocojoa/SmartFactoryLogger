<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="SmartFactoryLogger">
  <Profiles>
    <SystemCollector Id="SFLSystemCollector" Name="NT Kernel Logger">
      <BufferSize Value="64"/>
      <Buffers Value="1024"/>
    </SystemCollector>
    <SystemProvider Id="SFLThreadProvider">
      <Keywords>
        <Keyword Value="ProcessThread"/>
        <Keyword Value="CSwitch"/>
        <Keyword Value="ReadyThread"/>
        <Keyword Value="ThreadPriority"/>
        <Keyword Value="Loader"/>
      </Keywords>
      <Stacks><Stack Value="ReadyThread"/></Stacks>
    </SystemProvider>
    <Profile Id="SFLThreadScheduling.Light.Memory" Name="SFLThreadScheduling"
             Description="Bounded controlled wake correlation with ReadyThread stacks"
             LoggingMode="Memory" DetailLevel="Light">
      <Collectors>
        <SystemCollectorId Value="SFLSystemCollector">
          <SystemProviderId Value="SFLThreadProvider"/>
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
