{
  "name": "smart-factory-logger-v2",
  "version": "1.0.9",
  "description": "Smart Factory Logger V2 Dashboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "profile:react": "node scripts/collect_react_profiler.cjs",
    "profile:react:mock": "node scripts/react_profiler_mock_backend.cjs",
    "health": "npm run health:frontend:typecheck && npm run health:frontend:lint && npm run health:frontend:test && npm run health:backend:lint && npm run health:backend:typecheck && npm run health:backend:test",
    "health:frontend:typecheck": "npm --prefix frontend run typecheck",
    "health:frontend:lint": "npm --prefix frontend run lint",
    "health:frontend:test": "npm --prefix frontend run test",
    "health:backend:lint": ".\\\\backend\\\\.venv\\\\Scripts\\\\python.exe -m ruff check",
    "health:backend:typecheck": ".\\\\backend\\\\.venv\\\\Scripts\\\\python.exe -m mypy",
    "health:backend:test": ".\\\\backend\\\\.venv\\\\Scripts\\\\python.exe -m unittest discover -s backend/tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^24.13.3",
    "playwright": "^1.60.0"
  },
  "dependencies": {
    "tree-kill": "^1.2.2"
  },
  "build": {
    "appId": "com.smartfactory.logger",
    "files": [
      "main.js",
      "package.json",
      "node_modules/**/*",
      "!sf-health-*",
      "!.tmp_*",
      "!_tmp_*",
      "!qa_evidence",
      "!server_stdout.zip",
      "!*.pdf",
      "!*.csv",
      "!tmp_*.bin"
    ],
    "win": {
      "target": "nsis",
      "icon": "backend/assets/icon.ico"
    },
    "asar": true,
    "extraResources": [
      {
        "from": "backend/dist/SmartFactoryBackend.exe",
        "to": "backend/SmartFactoryBackend.exe"
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      }
    ]
  }
}
