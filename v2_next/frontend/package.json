    "@testing-library/user-event": "^13.5.0",
    "@types/html2canvas": "^0.5.35",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.1",
    "@types/react-grid-layout": "^1.3.6",
    "axios": "^1.18.0",
    "emotion": "^11.0.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.562.0",
    "moment": "^2.30.1",
    "moment-timezone": "0.5.47",
    "ol": "^10.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.3",
    "recharts": "^3.6.0",
    "typescript": "5.0.4",
    "uplot": "^1.6.32",
    "web-vitals": "^2.1.4",
    "zustand": "^5.0.13"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build && node scripts/copy_startup_splash.cjs",
    "preview": "vite preview",
    "test": "node --test scripts/patch_grafana_scenes_grid.test.cjs scripts/verify_grafana_router_contract.test.cjs && node scripts/run_vitest_tests.cjs",
    "test:ci": "npm test",
    "patch:scenes-grid": "node scripts/patch_grafana_scenes_grid.js",
    "verify:router-contract": "node scripts/verify_grafana_router_contract.cjs",
    "postinstall": "npm run patch:scenes-grid && npm run verify:router-contract",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "@grafana/e2e-selectors": "12.4.10",
    "@grafana/i18n": "12.4.10",
    "@grafana/schema": "12.4.10",
    "@grafana/data": {
      "dompurify": "3.4.15",
      "react-use": "17.6.1"
    },
    "@grafana/runtime": {
      "react-use": "17.6.1"
    },
    "@grafana/ui": {
      "immutable": "5.1.9",
      "uuid": "11.1.1",
      "react-use": "17.6.1",
      "react-router-dom-v5-compat": "npm:react-router-dom@7.18.3"
    },
    "@grafana/scenes": {
      "react-grid-layout": "1.3.4",
      "react-use": "17.6.1",
      "react-router-dom": "$react-router-dom"
    }
  },
  "devDependencies": {
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  }
